    "prompt": "{"intent":"复习保存条件","mode":"work","strategy":"work","locale":"zh-CN","analysisMode":"balanced","semanticStructure":false,"coverage":{"confirmedSourceCount":1,"includedSourceCount":1,"sampled":true,"stage":"synthesis","final":true,"sourceSegmentCount":1},"passages":[{"id":"n0-0-1","conversationId":"snapshot-0","sourceConversationIds":["snapshot-0"],"title":"保存条件","messageId":"snapshot-0-m","date":1,"text":"保存条件\\n用户确认后才保存。失败保留原文。","wikiOwnerId":"wiki-owner:4:1b0k59r"}],"overviewFromWiki":true,"projectBoundary":{"organizingIntent":"复习保存条件","sourceTitles":["保存条件 0"],"sourceTitleCount":1},"sourceRouting":[],"wikiTopics":[{"ownerId":"wiki-owner:4:1b0k59r","title":"保存条件","question":"保存条件","opening":true,"chapterOutline":[{"title":"授权与失败","question":"授权与失败"}],"subtopics":[{"title":"授权与失败","question":"授权与失败","evidenceIds":["n0-0-1"]}]}]}",

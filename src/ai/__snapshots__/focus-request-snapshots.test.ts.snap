    "prompt": "{"presentation":"wiki_topic_plan","version":18,"locale":"zh-CN","catalogueSignature":"47:1ujd38r","sections":[{"id":"m0","title":"保存条件","kind":"finding","lead":"保存条件\\n用户确认后才保存。失败保留原文。","scopeContext":{"complete":true,"omittedDetails":0,"omittedQuotes":0}}],"projectBoundary":{"organizingIntent":"复习保存条件","sourceTitles":["保存条件 0"],"sourceTitleCount":1},"includedMaterialIds":[],"routingProtocol":1,"routingSlots":["m0"]}",
